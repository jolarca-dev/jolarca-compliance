# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Environments / secrets
.env
.env.*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/

# ── Compliance repo excludes ────────────────────────────────────────────────
# NEVER commit: signed originals cache, local exports of personal data,
# DSR/investigation working files. These stay in the encrypted evidence vault.
signed-originals/
exports/
*.export.*
local-evidence/
dsr-working/
*.eml
*.msg

# Policy-mandated exclusions — jolarca-control policy/repo-defaults.yml
# data_handling.required_gitignore_patterns (readiness audit F-12).
# Key material, certs and Terraform state must never reach the object store.
*.pem
*.key
*.p12
secrets.json
credentials.json
*.tfstate
*.tfstate.*
.terraform/
